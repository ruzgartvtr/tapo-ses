{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.tsx", "electron/**/*.ts", "components/**/*.tsx", "lib/**/*.ts", "bridge/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "dist-electron", "release"]
}
